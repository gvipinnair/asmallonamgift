<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Onam Surprise – Gowri</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
<main id="app">

  <!-- 1. INTRO -->
  <section class="scene intro-scene active" id="introScene">
    <img class="intro-art" src="assets/intro-screen.png" alt="A little Onam surprise for Gowri">
    <div class="intro-overlay">
      <button class="action intro-button button-gold" id="enterHome">Open the door 🚪</button>
    </div>
  </section>

  <!-- 2. DOOR -->
  <section class="scene movie-scene" id="doorScene" aria-label="Door welcome">
    <svg class="door-shot" viewBox="0 0 1200 650" aria-hidden="true">
      <!-- hand-drawn doorway -->
      <g class="doorframe-ink">
        <path class="line thick" d="M215 565V110H515"/>
        <path class="line" d="M240 565V145H500"/>
        <path class="line" d="M215 110H515"/>
        <path class="line" d="M500 145L585 178"/>
      </g>

      <!-- open wooden door -->
      <g class="open-door-leaf">
        <path class="line thick" d="M500 145L740 62V505L500 565Z"/>
        <path class="line" d="M525 184L704 122V428L525 473Z"/>
        <path class="line" d="M523 360L705 314"/>
        <circle class="ink" cx="700" cy="270" r="7"/>
      </g>

      <!-- girl holding the handle -->
      <g class="door-girl-human">
        <path class="line thick" d="M790 210q52-58 108 0q-12 26-3 82q8 58-20 93"/>
        <path class="line" d="M816 211q24-26 56 0"/>
        <path class="line" d="M820 237h8m38 0h8M820 262q20 15 40 0"/>
        <path class="line" d="M820 300V470"/>
        <path class="line arm-hold" d="M820 330L750 350L700 300"/>
        <path class="line" d="M820 332L890 374"/>
        <path class="line leg-left" d="M820 470L775 565"/>
        <path class="line leg-right" d="M820 470L870 565"/>
        <path class="line hair-strand" d="M804 222q-34 63 8 151M892 220q14 56-15 132"/>
      </g>

      <g class="door-motion-lines">
        <path class="line" d="M770 145q36-28 76-34"/>
        <path class="line" d="M765 164l18-9"/>
      </g>
    </svg>

    <div class="speech speech-coral door-speech">Hey Gowri, come inside! 🌸</div>
    <button class="action button-pink hidden" id="comeInside">Come inside ✨</button>
  </section>

  <!-- 3. HOUSE CHAOS -->
  <section class="scene movie-scene" id="insideScene" aria-label="Inside the house">
    <div class="simple-home">
      <div class="window"></div>
      <div class="lamp-doodle"></div>
      <div class="floor-line"></div>
      <div class="plant-doodle"></div>
      <div class="sadya-table">
        <div class="leaf"></div><div class="sadya-plate p1"></div><div class="sadya-plate p2"></div><div class="sadya-plate p3"></div>
      </div>
    </div>

    <svg class="drawing inside-drawing" viewBox="0 0 1200 650" aria-hidden="true">
      <!-- children -->
      <g class="child child-one">
        <circle class="line" cx="280" cy="300" r="35"/><path class="line" d="M280 335V455M280 365L225 405M280 365L338 400M280 455L245 540M280 455L325 535"/>
      </g>
      <g class="child child-two">
        <circle class="line" cx="930" cy="315" r="34"/><path class="line" d="M930 350V470M930 380L875 420M930 380L988 415M930 470L895 545M930 470L972 545"/>
      </g>

      <!-- mouse: drops from top -->
      <g class="mouse">
        <circle class="line" cx="560" cy="490" r="25"/>
        <circle class="line" cx="545" cy="464" r="9"/><circle class="line" cx="576" cy="464" r="9"/>
        <circle class="ink" cx="548" cy="490" r="3"/>
        <path class="line" d="M538 510q-55 10-75 48"/>
      </g>

      <!-- cat chases -->
      <g class="cat">
        <circle class="line" cx="715" cy="492" r="33"/>
        <path class="line" d="M692 468L682 440L707 454M725 454L750 440L739 468"/>
        <path class="line" d="M685 520L650 564M735 520L770 558M742 492q48 8 75-22"/>
        <circle class="ink" cx="704" cy="486" r="3"/><circle class="ink" cx="724" cy="486" r="3"/>
      </g>

      <!-- playing ball -->
      <circle class="play-ball" cx="430" cy="500" r="18"/>
    </svg>

    <div class="caption color-cap">A little Onam chaos! 🐭 🐱</div>
    <button class="action button-green" id="continueInside">Continue ✨</button>
  </section>

  <!-- 4. COMPLIMENT -->
  <section class="scene movie-scene" id="complimentScene" aria-label="Compliment">
    <svg class="drawing compliment-drawing" viewBox="0 0 1200 650" aria-hidden="true">
      <g class="compliment-person">
        <circle class="line" cx="700" cy="240" r="62"/>
        <path class="line" d="M654 225q46-48 92 0M675 240h6m37 0h6M676 270q24 20 48 0"/>
        <path class="line" d="M700 300V485"/>
        <path class="line arm-wave" d="M700 335L770 370L816 300"/>
        <path class="line arm-other" d="M700 335L620 395"/>
        <path class="line leg-a" d="M700 485L640 600"/>
        <path class="line leg-b" d="M700 485L770 600"/>
      </g>
      <g class="small-gowri">
        <circle class="line" cx="380" cy="300" r="42"/>
        <path class="line" d="M350 288q30-30 60 0M366 305h6m28 0h6M366 325q14 11 28 0"/>
        <path class="line" d="M380 342V475M380 385L330 430M380 385L430 430M380 475L340 555M380 475L420 555"/>
      </g>
    </svg>
    <div class="speech speech-lavender compliment-bubble">You look so beautiful today! ❤️</div>
    <button class="action button-purple" id="continueCompliment">See what happens…</button>
  </section>

  <!-- 5. MAHABALI -->
  <section class="scene movie-scene" id="mahabaliScene" aria-label="Mahabali surprise">
    <svg class="drawing maha-drawing" viewBox="0 0 1200 650" aria-hidden="true">
      <g class="mahabali">
        <circle class="line" cx="480" cy="235" r="70"/>
        <path class="line" d="M425 215q55-78 110 0M438 182l42-32 42 32M445 250q35 25 70 0"/>
        <path class="line" d="M480 305V500"/>
        <path class="line maha-arm-up" d="M480 350L585 290L610 180"/>
        <path class="line maha-arm-down" d="M480 350L375 425"/>
        <path class="line leg-a" d="M480 500L395 595"/><path class="line leg-b" d="M480 500L550 595"/>
        <path class="line crown" d="M440 170l40-60 40 60M456 145l24-28 24 28"/>
      </g>

      <g class="flower-burst">
        <path class="line petal" d="M670 170q24-20 48 0q-24 20-48 0M694 146q20 24 0 48q-20-24 0-48"/>
        <path class="line petal" d="M760 225q24-20 48 0q-24 20-48 0M784 201q20 24 0 48q-20-24 0-48"/>
        <path class="line petal" d="M700 300q20-18 40 0q-20 18-40 0M720 280q18 20 0 40q-18-20 0-40"/>
        <path class="line petal" d="M850 170q18-16 36 0q-18 16 0 32q-18 16-36 0q18-16 0-32"/>
        <path class="line petal" d="M900 290q16-14 32 0q-16 14 0 28q-16 14-32 0q16-14 0-28"/>
      </g>

      <g class="glass-bangles">
        <ellipse class="bangle pink" cx="700" cy="214" rx="29" ry="10"/>
        <ellipse class="bangle blue" cx="750" cy="255" rx="29" ry="10"/>
        <ellipse class="bangle green" cx="700" cy="305" rx="29" ry="10"/>
        <ellipse class="bangle gold" cx="790" cy="300" rx="29" ry="10"/>
      </g>
    </svg>
    <div class="speech speech-orange maha-bubble">Vipin told me that you like bangles, so I bought them for you! 💕</div>
    <div class="tiny-onam">Happy Onam, Gowri! 🌸</div>
    <button class="action button-pink" id="readyHall">Are you ready for the hall? ✨</button>
  </section>

  <!-- 6. LOCKED HALL DOOR -->
  <section class="scene movie-scene" id="hallDoorScene" aria-label="Hall door">
    <div class="hall-room">
      <div class="hall-wall"></div>
      <div class="hall-floor"></div>
      <div class="hall-diya left"></div><div class="hall-diya right"></div>
      <div class="garland garland-top"></div>
      <div class="closed-hall-door" id="closedHallDoor">
        <div class="hall-door-leaf left-leaf"></div>
        <div class="hall-door-leaf right-leaf"></div>
        <div class="door-center-gap"></div>
        <div class="door-knob left-knob"></div>
        <div class="door-knob right-knob"></div>
        <div class="door-lock" id="doorLock"></div>
      </div>
    </div>
    <div class="speech speech-blue hall-bubble">Are you ready to enter the hall?</div>
    <button class="action button-blue" id="enterHall">Enter the hall ✨</button>
  </section>

  <!-- 7. POOKALAM REVEAL -->
  <section class="scene reveal-scene" id="revealScene" aria-label="Gowri pookalam reveal">
    <div class="reveal-glow"></div>
    <div class="reveal-wrap">
      <img class="pookalam" src="assets/gowri-pookalam-face.png" alt="Gowri portrait made from Onam flowers">
      <div class="note note-one">♪</div>
      <div class="note note-two">♫</div>
    </div>
    <div class="reveal-caption">Gowri… this one is for you. 🌼</div>
    <button class="action button-orange" id="postcardBtn">Open your postcard 💌</button>
  </section>

  <!-- 8. POSTCARD -->
  <section class="scene postcard-scene" id="postcardScene" aria-label="Postcard">
    <article class="postcard">
      <div class="small-flower">🌸</div>
      <p class="label">A little Onam wish for you</p>
      <h1>Happy Onam, Gowri! 🌼</h1>
      <p>I haven’t even seen you in a dhavani yet,<br>but somehow I already know you’re going to look<br>beautiful in it. ❤️</p>
      <p>I just wanted to make this little Onam surprise especially for you.</p>
      <strong>Happy Onam, Gowri! ✨</strong>
    </article>
    <button class="restart button-pink" id="restart">Watch again ↻</button>
  </section>

</main>
<audio id="voice" preload="auto" src="assets/gowri-voice.mp3"></audio>
<script src="script.js"></script>
</body>
</html>
